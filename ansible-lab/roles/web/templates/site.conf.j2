server {
    listen {{ port_web }} default_server;
    root /var/www/html;
    index index.html;

    add_header X-Serveur "{{ inventory_hostname }}";

    location /sante {
        return 200 "OK depuis {{ inventory_hostname }}\n";
    }

    location /admin {
        auth_basic "Zone admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        try_files /index.html =404;
    }
}
